# Local development defaults for `pnpm dev`, loaded by `next dev`. Override any
# of them in .env.development.local, which is not committed.
#
# What each app's own .env.development says, for serving them all from one
# origin: id at /id and members at /members, on port 3000. `pnpm modular:dev`
# uses the apps' files instead. Every variable is described in the apps'
# .env.example.

# id: its URL is before the mount point, which it adds itself.
FG_ID_URL=http://localhost:3000
FG_ID_NAME=Fair Garden

# members signs in with id, and supplies the `membership` scope's claims to
# any other service a person shares it with.
FG_ID_SERVICE_MEMBERS_URL=http://localhost:3000/members
FG_ID_SERVICE_MEMBERS_NAME=Members
FG_ID_SERVICE_MEMBERS_SECRET=dev-only-members-secret
FG_ID_SERVICE_MEMBERS_CLAIMS=membership

# members: likewise before its mount point; the id service is its issuer.
FG_MEMBERS_URL=http://localhost:3000
FG_MEMBERS_ID_URL=http://localhost:3000/id
FG_MEMBERS_CLIENT_ID=members
FG_MEMBERS_CLIENT_SECRET=dev-only-members-secret
FG_MEMBERS_SECRET=dev-only-members-session-secret

# The embedded databases the apps keep for themselves, so whatever you set up
# under `pnpm modular:dev` is here too, and the other way around.
FG_ID_DATA_DIR=../id/.data/id
FG_MEMBERS_DATA_DIR=../members/.data/members
