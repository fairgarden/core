# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files; .env.development holds shared defaults and is committed
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# symlinks are committed to /src/app, /src/pages and /public so they can be
# followed on GitHub; /app and /pages are derived from them for Next, which
# cannot discover routes through a symlinked directory
/app/
/pages/

# generated by next dev
AGENTS.md
CLAUDE.md

# fg-dist policy use: the distribution's policy, for this build to run
/.policy

# embedded development databases, when not the apps' own
/.data
