{
  "name": "@fairgarden/core",
  "version": "26.09.01-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fairgarden/core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm dist env check --build --cwd apps/monolith && turbo run build --filter=./apps/monolith && pnpm --filter=./apps/monolith run --if-present migrate",
    "dev": "turbo run dev --filter=./apps/monolith",
    "modular:build": "pnpm dist env check --build --cwd apps/id && pnpm dist env check --build --cwd apps/members && turbo run build --filter='./apps/*' --filter='!./apps/monolith' && pnpm --filter='./apps/*' --filter='!./apps/monolith' run --if-present migrate",
    "modular:dev": "turbo run dev --filter='./apps/*' --filter='!./apps/monolith'",
    "docs:build": "turbo run build --filter='./apps/*/docs' --filter='./packages/*/docs'",
    "docs:dev": "turbo run dev --filter='./apps/*/docs' --filter='./packages/*/docs'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "canary": "node packages/distribution/src/cli.ts canary",
    "next-version": "node packages/distribution/src/cli.ts next-version",
    "release:check": "node packages/distribution/src/cli.ts release --check",
    "changelog": "node packages/distribution/src/cli.ts changelog",
    "dist": "node packages/distribution/src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "@fairgarden/distribution": "^0.1.0-alpha.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "files": [
    "policies"
  ]
}
